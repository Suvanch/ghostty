# Old config saved as config.backup

# --- Theme & colors ---
# Others to try: Catppuccin Mocha, Rose Pine, Kanagawa Wave, Gruvbox Dark, Dracula
# Preview all: ghostty +list-themes
theme = TokyoNight Night
background-opacity = 0.92
window-theme = ghostty

# --- Font ---
font-family = "JetBrainsMono Nerd Font"
font-size = 13
font-feature = calt
font-feature = liga
adjust-cell-height = 10%

# --- Window ---
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-width = 110
window-height = 30
unfocused-split-opacity = 0.85

# --- Cursor ---
cursor-style = bar
cursor-style-blink = true

# --- Behavior ---
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

# --- Shaders (applied in order; comment a line out to disable) ---
custom-shader = /home/suvanch/.config/ghostty/shaders/cursor_trail.glsl
custom-shader = /home/suvanch/.config/ghostty/shaders/bloom.glsl
custom-shader-animation = true
